{
  "name": "@cacsms/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "sql"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node -e \"console.log('database lint: pending rule package')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"console.log('database tests: pending module implementation')\"",
    "db:ping": "tsx src/ping.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:bootstrap": "tsx src/bootstrap-module01.ts",
    "db:bootstrap-module02": "tsx src/bootstrap-module02.ts",
    "db:bootstrap-module03": "tsx src/bootstrap-module03.ts",
    "db:bootstrap-module04": "tsx src/bootstrap-module04.ts",
    "db:clear-demo": "tsx src/clear-demo-data.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
